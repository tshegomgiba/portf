# Public Web3Forms access key. Safe to ship in the client bundle: Web3Forms
# treats this as an alias for the inbox, not a secret. Vite reads this file
# during `npm run build`, which is what Vercel runs, so the hosted form has
# the same key as local without extra dashboard setup.
VITE_WEB3FORMS_KEY=619de087-0c8c-4cd2-b2f4-402f8d1c36f2
